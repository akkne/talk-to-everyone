{
  "uid": "game-operations",
  "title": "Игра · состояние и ошибки",
  "tags": ["game", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Игроки онлайн", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "game_connected_players", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2, "title": "Лобби", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "game_active_lobbies", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3, "title": "Матчи", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "game_active_matches", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4, "title": "API доступен", "type": "stat", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"game-backend\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 5, "title": "HTTP запросы и ошибки в секунду", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_received_total{job=\"game-backend\"}[5m]))", "legendFormat": "Все", "refId": "A" },
        { "expr": "sum(rate(http_requests_received_total{job=\"game-backend\",code=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6, "title": "HTTP p95, секунды", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"game-backend\",endpoint!~\".*hubs/game.*\"}[5m])))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7, "title": "Генерации NPC в минуту", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (purpose, outcome) (rate(game_llm_requests_total[5m])) * 60", "legendFormat": "{{purpose}} · {{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8, "title": "Генерация NPC p95, секунды", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (purpose, le) (rate(game_llm_duration_seconds_bucket[5m])))", "legendFormat": "{{purpose}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9, "title": "События комнаты", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(game_lobbies_created_total[5m])", "legendFormat": "Лобби созданы", "refId": "A" },
        { "expr": "increase(game_lobby_joins_total[5m])", "legendFormat": "Входы", "refId": "B" },
        { "expr": "increase(game_matches_started_total[5m])", "legendFormat": "Матчи начаты", "refId": "C" },
        { "expr": "increase(game_lobby_kicks_total[5m])", "legendFormat": "Кики", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 10, "title": "SignalR соединения", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "game_signalr_connections", "legendFormat": "Соединения", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 11, "title": "Отклонённые игровые команды", "type": "timeseries", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (operation, reason) (increase(game_hub_rejections_total[5m]))", "legendFormat": "{{operation}} · {{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 12, "title": "Логи API", "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=\"backend\"}", "refId": "A", "queryType": "range" }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}

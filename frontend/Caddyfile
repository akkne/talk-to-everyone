{
	default_sni {$CADDY_DOMAIN:127.0.0.1}
}

(site) {
	encode zstd gzip

	@backend path /api/* /hubs/* /health /health/db
	handle @backend {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

localhost {
	import site
}

{$CADDY_DOMAIN:127.0.0.1} {
	tls internal
	import site
}

http://:80 {
	redir https://{host}{uri} 308
}

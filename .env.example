# Public DNS name for HTTPS. Keep localhost for local development.
CADDY_DOMAIN=localhost

# PostgreSQL data and password. Set a unique password before starting.
POSTGRES_DB=talk_to_everyone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Game login tokens (each at least 16 characters).
GAME_TOKENS=leader:replace_with_a_long_random_leader_token,judge:replace_with_a_long_random_judge_token

# Optional OpenAI-compatible chat completions API for NPC answers.
# Without these values the game still starts, but questions to NPCs fail.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Public DNS name for HTTPS (Caddy). Keep localhost for local development.
CADDY_DOMAIN=localhost

# PostgreSQL data and password. Set a unique password before starting.
POSTGRES_DB=talk_to_everyone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=Host=localhost;Port=5432;Database=talk_to_everyone;Username=postgres;Password=postgres

# Room codes and JWT for LAN / Web multiplayer
GAME_HOST_CODE=host
GAME_ROOM_CODE=1234
GAME_ROUND_SECONDS=120
GAME_CHOICE_SECONDS=45
JWT_SECRET=talk-to-everyone-super-secret-jwt-key-2026-min-32-bytes

# Docker Compose starts Ollama and downloads this model automatically.
# For local dotnet run, set OLLAMA__BASEURL=http://localhost:11434.
# For a host Ollama with Docker backend, set OLLAMA__BASEURL=http://host.docker.internal:11434.
# Leave OLLAMA__BASEURL unset to use the Ollama service in Docker Compose.
OLLAMA__MODEL=qwen2.5:3b-instruct
OLLAMA__TIMEOUTSECONDS=90

# Optional OpenAI-compatible chat completions API for NPC answers.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Backend HTTP port
BACKEND_PORT=5000

# PostgreSQL configuration
POSTGRES_DB=talk_to_everyone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_PORT=5432
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=postgres;Port=5432;Database=talk_to_everyone;Username=postgres;Password=change_me_in_env

# Ollama local LLM configuration
# Recommended models: qwen2.5:14b-instruct-q4_K_M / llama3.1:8b-instruct-q8_0
OLLAMA__BASEURL=http://ollama:11434
OLLAMA__MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA__TIMEOUTSECONDS=30
OLLAMA__KEEPALIVE=-1
OLLAMA__QUEUECAPACITY=64
OLLAMA__AUTOPULLMODEL=true
OLLAMA__MAXHISTORYENTRIES=12

# Speaker turn inference parameters (temperature: 0.75, num_ctx: 4096, num_predict: 140)
OLLAMA__SPEAKERTEMPERATURE=0.75
OLLAMA__SPEAKERCONTEXTTOKENS=4096
OLLAMA__SPEAKERPREDICTTOKENS=140

# Background reactions batch inference parameters (temperature: 0.6, num_ctx: 2048, num_predict: 180)
OLLAMA__REACTIONTEMPERATURE=0.6
OLLAMA__REACTIONCONTEXTTOKENS=2048
OLLAMA__REACTIONPREDICTTOKENS=180

# Backend HTTP port
BACKEND_PORT=5000

# Host LAN/VPN IP or public DNS name for HTTPS invitations (Caddy).
# When using a private IP, players must trust Caddy's local root certificate.
# Keep 127.0.0.1 for local-only development; localhost is always enabled.
CADDY_DOMAIN=127.0.0.1

# PostgreSQL data and password. Set a unique password before starting.
POSTGRES_DB=talk_to_everyone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Only for running dotnet on the host; Docker Compose connects to its postgres service directly.
DATABASE_URL=Host=localhost;Port=5432;Database=talk_to_everyone;Username=postgres;Password=postgres

# Redis configuration for dynamic game state, movement and gamification
REDIS_PORT=6379
REDIS_URL=localhost:6379

# JWT and round timing for LAN / Web multiplayer
GAME_ROUND_SECONDS=120
GAME_CHOICE_SECONDS=45
JWT_SECRET=talk-to-everyone-super-secret-jwt-key-2026-min-32-bytes

# Docker Compose starts Ollama and downloads this model automatically.
# For local dotnet run, set OLLAMA__BASEURL=http://localhost:11434.
# For a host Ollama with Docker backend, set OLLAMA__BASEURL=http://host.docker.internal:11434.
# Leave OLLAMA__BASEURL unset to use the Ollama service in Docker Compose.
OLLAMA__MODEL=qwen2.5:3b-instruct
OLLAMA__TIMEOUTSECONDS=90
OLLAMA__CONTEXTTOKENS=8192

# Optional OpenAI-compatible chat completions API for NPC answers.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=

# Backend HTTP port
BACKEND_PORT=5000

# Grafana is available only on the host at http://localhost:3000 by default.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

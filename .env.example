# PostgreSQL configuration
POSTGRES_DB=talk_to_everyone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_PORT=5432
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=postgres;Port=5432;Database=talk_to_everyone;Username=postgres;Password=change_me_in_env

# Ollama local LLM configuration (8 GB VRAM default: qwen2.5:7b-instruct or gemma3:4b)
OLLAMA__BASEURL=http://ollama:11434
OLLAMA__MODEL=qwen2.5:7b-instruct
OLLAMA__TIMEOUTSECONDS=30
OLLAMA__MAXCONTEXTTOKENS=4096
OLLAMA__MAXPREDICTTOKENS=120
OLLAMA__REACTIONBATCHPREDICTTOKENS=480
OLLAMA__MAXHISTORYENTRIES=12
OLLAMA__TEMPERATURE=0.75
OLLAMA__KEEPALIVE=-1
OLLAMA__QUEUECAPACITY=64
OLLAMA__AUTOPULLMODEL=true

# Backend HTTP port
BACKEND_PORT=5000
